{
  "name": "device-test-guard-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "test:ci": "npm run test:status",
    "test:duplicates": "node --test tests/duplicates.test.mjs",
    "test:security": "node --test tests/batch-contract.test.mjs",
    "test:all": "node --test tests/*.test.mjs",
    "test:status": "node --test tests/status.test.mjs"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@angular/build": {
      "piscina": "5.3.2"
    }
  }
}
